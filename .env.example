# =============================================================================
# Quota Dashboard — configuration
# =============================================================================
# Real data is the DEFAULT. Copy this file to `.env` and fill in what you have.
# Variables already present in your OS/user environment take precedence, so you
# only need to set the ones that are missing.
#
#   cp .env.example .env
#   npm run dev
# =============================================================================

# --- Claude (Anthropic Pro / Max) -------------------------------------------
# Claude is read from whichever credential you have:
#   a) OAuth token from Claude Code  ->  ~/.claude/.credentials.json  (preferred)
#      (run `claude` once and log in; the file appears automatically)
#   b) claude.ai web session cookie  ->  paste the `sessionKey` cookie value
#   c) an explicit OAuth token
CLAUDE_SESSION_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
# Only needed if you're not logged into Claude Code on this machine:
CLAUDE_ORG_UUID=

# --- ChatGPT (Codex) --------------------------------------------------------
# Read from ~/.codex/auth.json (written by `codex login`). Codex access tokens
# expire; the dashboard does NOT refresh them unless you opt in below, because
# OpenAI rotates refresh tokens and rotating them silently can break Codex.
CODEX_ENABLE_REFRESH=0
# CODEX_AUTH_PATH=          # override the auth.json location

# --- Kimi (Kimi Code Plan) --------------------------------------------------
# A Kimi *Code* key (sk-kimi-…), NOT a platform.moonshot.ai key.
KIMI_API_KEY=

# --- MiniMax ----------------------------------------------------------------
# A coding-plan key (sk-cp-…).
MINIMAX_API_KEY=
# MINIMAX_USAGE_ENDPOINT=   # override (CN: https://api.minimaxi.com/v1/token_plan/remains)

# --- DeepSeek (metered balance) ---------------------------------------------
DEEPSEEK_API_KEY=
# Optional: real per-model token usage from platform.deepseek.com. This is the
# browser session token, NOT the sk- API key. Log in, then run in the console:
#   JSON.parse(localStorage.getItem('userToken')).value
DEEPSEEK_PLATFORM_TOKEN=

# --- DeepInfra (metered spend) ----------------------------------------------
DEEPINFRA_API_KEY=

# --- Qwen (Alibaba ModelStudio Token Plan) ----------------------------------
# No credential needed: the plan's model catalog is read from ~/.qwen/settings.json.
# There is no public quota endpoint for the token plan, so its card shows
# UNAVAILABLE while token usage comes from local Qwen CLI logs.
# QWEN_SETTINGS_PATH=      # override the settings.json location

# --- Gemini CLI (Google Code Assist) ---------------------------------------
# One card per Google account. Link each account once:
#   npm run gemini-login -- second@example.com
#   npm run gemini-login -- you@example.com
# Credentials are written in Gemini CLI format to
#   ~/.gemini-profiles/<slug>/.gemini/oauth_creds.json
#
# gemini-login uses the installed-app OAuth clients below. Client IDs are
# public; the client secrets are not confidential either, but they are kept out
# of the repository to satisfy GitHub secret scanning. Supply them here.
GEMINI_OAUTH_CLIENT_SECRET=
ANTIGRAVITY_OAUTH_CLIENT_SECRET=
# GEMINI_OAUTH_CLIENT_ID=
# ANTIGRAVITY_OAUTH_CLIENT_ID=
# Extra existing GEMINI_CLI_HOME dirs can be supplied comma-separated:
# GEMINI_CLI_HOMES=
# Per-account GCP project overrides (email=project):
# GEMINI_ACCOUNT_PROJECTS=
# GEMINI_PROFILE_ROOT=       # override the profile root

# --- Operational knobs ------------------------------------------------------
# Scrape cadence in seconds (minimum 10).
SCRAPE_INTERVAL=60
# Per-request HTTP timeout and retry count for provider scrapers.
SCRAPE_HTTP_TIMEOUT_MS=15000
SCRAPE_HTTP_RETRIES=3
# Model catalogs change slowly — cache them (ms). Default 15 min.
CATALOG_TTL_MS=900000
# Local token-usage scan tuning.
USAGE_LOOKBACK_HOURS=26
USAGE_MAX_FILE_BYTES=16777216
USAGE_MAX_FILES=400
# Claude's OAuth usage endpoint rate-limits hard (HTTP 429). Poll it at most
# this often, and wait this long after a 429. Cached readings older than the
# max age are not shown. Defaults: 5 min, 10 min, 6 h.
CLAUDE_MIN_FETCH_INTERVAL_MS=300000
CLAUDE_RATE_LIMIT_BACKOFF_MS=600000
CLAUDE_CACHE_MAX_AGE_MS=21600000
# API server bind.
API_PORT=8787
API_HOST=127.0.0.1

# --- Agent query layer (llmquota CLI + MCP server) --------------------------
# Snapshot path, API base, and refresh policy for `llmquota` / `npm run mcp`.
# LLMQUOTA_STATE=data/state.json
# LLMQUOTA_API=http://127.0.0.1:8787
# Set 0 to never scrape implicitly when a snapshot is stale.
# LLMQUOTA_AUTO_REFRESH=1
# LLMQUOTA_MAX_AGE_SEC=300
# LLMQUOTA_REFRESH_TIMEOUT_MS=90000
